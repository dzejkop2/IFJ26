// ---------------------------------------------------------------------
// [EXTKW] rozsirujuce metody, bezparametricka metoda bez zatvoriek
// ---------------------------------------------------------------------
extension (value: Int)
  def twice: Int = value * 2
  def foo(): String = "foo" + value.toString
  def plus(other: Int): Int = value + other

// ---------------------------------------------------------------------
// [PARAMLISTS] funkcia bez zoznamu parametrov a s viacerymi zoznamami
// ---------------------------------------------------------------------
def answer: Int = 42
def answerWithParens(): Int = 42
def add3(a: Int)(b: Int)(c: Int): Int = a + b + c
def offset()(value: Int): Int = value + 1

// ---------------------------------------------------------------------
// [ZAKLAD] jednoriadkova funkcia, viacriadkova hlavicka, koncova ciarka
// ---------------------------------------------------------------------
def add(a: Int, b: Int): Int = a + b

def describe(
  x: Int,
  y: Double,
  ): String =
  var label: String = ""
  if x < 0 then
    label = "negative"
  else if x == 0 then
    label = "zero"
  else
    label = "positive"   /* [K4] viacriadkovy blokovy komentar
                              ukoncuje logicky riadok */
  label

// [REKURZIA] rekurzia s explicitnym navratovym typom, samostatne ()
def fib(n: Int): Int =
  if n <= 1 then
    return n
  else
    ()
  fib(n - 1) + fib(n - 2)

// ---------------------------------------------------------------------
// [CISLA] vsetky tvary celociselnych a desatinnych literalov
// ---------------------------------------------------------------------
def numbers(): Unit =
  val i1 = 0
  val i2 = 42
  val i3 = 1_000_000
  val i4 = 2147483647
  val i5 = 1_2_3
  val d1 = 3.14
  val d2 = .5
  val d3 = 0.5
  val d4 = 1e10
  val d5 = 1E+5
  val d6 = 2.5e-3
  val d7 = 1_0.2_5e+1_0
  val d8 = 7d
  val d9 = 2.0D
  val d10 = 0.0
  val d11 = 0e0
  val d12 = 1.5e1_0d
  val neg = -i2 + +i1 - -3
  val m1 = 5.toString          // [VALMEM] bodka za Int nie je desatinna
  val m2 = 1.2345.toString     // desatinne cislo, potom clen
  val m3 = d1.floor.toInt      // retazenie clenov
  val m4 = "abc".length
  val m5 = (i2 + 1).toString
  print(i1 * i2 / 2 - (i3 + i4))

// ---------------------------------------------------------------------
// [RETAZCE] escape sekvencie, prazdny retazec, viacriadkovy retazec
// ---------------------------------------------------------------------
def strings(): Unit =
  val empty = ""
  val e2 = ""; val e3 = "" + ""
  val esc = "tab\tquote\"backslash\\cr\rnewline\n"
  val slashes = "// toto nie je komentar /* ani toto */"
  val dollar = "$name ${x} sa v obycajnom retazci neinterpoluje"
  val multi = """prvy riadok
  "uvodzovky" a ""dvojite"" uvodzovky
    \n ostava doslova, // aj /* toto */"""
  val multiEmpty = """"""
  print(empty); print(esc); print(multi)

// ---------------------------------------------------------------------
// [BOOLTHEN] true/false, !, &&, ||, vsetky relacne operatory
// ---------------------------------------------------------------------
def logic(a: Int, b: Int): Boolean =
  val t = true
  val f = false
  val c1 = a < b && a <= b || a > b && a >= b
  val c2 = a == b || a != b
  val c3 = !t || !(a < b) && !!f
  val c4 = a<b&&b>a||a!=b
  if c1 && c2 then
    print("both")
  else if c3 then
    print("c3")
  t

// ---------------------------------------------------------------------
// [CONTROL] if ako vyraz, for s to/until/by a strazami
// ---------------------------------------------------------------------
def control(x: Int): Unit =
  val absolute = if x < 0 then 0 - x else x
  val abs2 = if x < 0 then
    0 - x
  else
    x
  val abs3 = if x < 0 then 0 - x else
    x
  for i <- 1 to 10 by 2 do
    print(i)
  for j<-0 until 3 do print(j)
  val limit = 10
  for
    i <- 0 until limit
    if i != 3
    if i < 8
  do
    print(i)
  val to = 1
  val until = 2
  val by = 3
  print(to + until + by)

// ---------------------------------------------------------------------
// [INTERPOLATEDS] vsetky tvary interpolovanych retazcov
// ---------------------------------------------------------------------
def interp(name: String, n: Int): Unit =
  val s = 5                                   // s ako bezna premenna
  val s1 = s + 1
  val _tmp = "t"
  print(s"$name${n + 1} costs $$0")           // priklad zo zadania
  print(s"")                                  // prazdny
  print(s"bez vlozenia")
  print(s"$name")                             // len premenna
  print(s"${n}")                              // len vyraz
  print(s"$name$_tmp$s1")                     // vlozenia tesne za sebou
  print(s"$name.")                            // $id konci na bodke
  print(s"[$name]($n)")
  print(s"$$$name$$")                         // $$ okolo vlozenia
  print(s"esc: \" \\ \t \n koniec")           // escape v s"..."
  print(s"${(n + 1) * 2 - -n}")               // zatvorky a unarny minus
  print(s"${"retazec" + name}!")              // retazec vo vyraze
  print(s"${toStr(add3(n)(1)(2))}")           // FUNEXP + PARAMLISTS
  print(s"${n.toString.length}")              // VALMEM
  print(s"${if n > 0 then "kladne" else "ine"}")  // CONTROL
  print(s"vonku ${s"vnutri ${n} $name"} vonku")   // vnorena interpolacia
  print(s"${ s"${ s"${n}" }" }")              // trojite vnorenie
  print(s"""Povedal "ahoj", $name.
Druhy riadok ${n + 1}, "" a $$ a \n doslova.""")
  print(s"""""")                              // prazdny viacriadkovy
  print(s"""jeden " a dva "" uvodzovky""")
  print(s "medzera")                          // s + medzera = ID a String

