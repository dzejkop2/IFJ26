// IFJ26 scanner stress test
/* block comment before the prolog
   spanning several lines /* with a nested one */
   and the outer comment continues */
import   ifj26 . *   // whitespace between prolog tokens is allowed

/** documentation-style comment with extra stars **/
def add(a: Int, b: Int): Int =
  a + b

def describe(
  x: Int,
  y: Double,
  ): String =
  var label: String = ""
  if x < 0 then
    label = "negative"
  else
    if x == 0 then
      label = "zero"
    else
      label = "positive"   /* block comment
                              that ends the logical line */
  label

// recursion needs an explicit return type
def fib(n: Int): Int =
  if n <= 1 then
    return n
  else
    ()
  val m1 = n - 1
  val m2 = n - 2
  val a = fib(m1)
  val b = fib(m2)
  a + b

def numbers(): Unit =
  val i1 = 0
  val i2 = 42
  val i3 = 1_000_000
  val d1 = 3.14
  val d2 = .5
  val d3 = 1e10
  val d4 = 2.5E-3
  val d5 = 1_0.2_5e+1_0
  val d6 = 7d
  val d7 = 0.0
  val total = i2 * i3 + i1 - (i2 / 2)
  print(total)
  print(d1)

def strings(): Unit =
  val empty = ""
  val esc = "tab\tquote\"backslash\\newline\n"
  val multi = """first line
  "quoted" and ""double"" quotes
    \n stays literal here"""
  print(empty)
  print(esc)
  print(multi)

@main
def main(): Unit =
  val x = 10 ; val y = 20   // two statements on one logical line
  var counter = 0
  val _tmp = 1
  val to = 2


        // comment line with a different indentation is ignored
	// a tab before a comment-only line is allowed
  /* single-line block comment on its own line */
  /* block comment */ var acc = 0
  while counter < x do
    counter = counter + 1
    if counter == 5 then
      print("five")
      print("\n")
    else
      /* nested block comment /* inside */ in a branch */
      acc = acc + counter
  val s = describe(x,
                   y)
  val r = add(
    x,
    y,
    )
  print(r)
  print(s)
  numbers()
  strings()
  var g = fib(x)
  if g > 0 then
    while g > 100 do
      if g >= 1000 then
        g = g - 1000
      else
        g = g - 100